{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-module" data-toggle="tooltip" title="Save" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="Cancel" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}

    <!-- Top Status Banner -->
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-plug"></i> SaaS Connector Settings &amp; Store Credentials</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-module" class="form-horizontal">
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="module_saas_connector_status" id="input-status" class="form-control">
                {% if module_saas_connector_status %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-secret-key"><span data-toggle="tooltip" title="{{ help_secret_key }}">{{ entry_secret_key }}</span></label>
            <div class="col-sm-10">
              <div class="input-group">
                <input type="text" name="module_saas_connector_secret_key" value="{{ module_saas_connector_secret_key }}" placeholder="{{ entry_secret_key }}" id="input-secret-key" class="form-control" style="font-family: monospace; font-weight: bold; background: #f8fafc;" readonly />
                <span class="input-group-btn">
                  <button class="btn btn-default" type="button" onclick="navigator.clipboard.writeText(document.getElementById('input-secret-key').value); alert('Secret Key copied to clipboard!');"><i class="fa fa-copy"></i> Copy</button>
                </span>
              </div>
              <span class="help-block">{{ help_secret_key }}</span>
            </div>
          </div>
        </form>
      </div>
    </div>

    <!-- Live Store Health Card & Capability Diagnostic Panel -->
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-heartbeat"></i> Store Field Compatibility Health &amp; Table Diagnostics</h3>
      </div>
      <div class="panel-body">
        <p class="text-muted" style="margin-bottom: 20px;">
          This connector automatically resolves the missing OpenCart schema limitations (Option SKUs, Multi-Tab Layouts, and Swatch Assets) without modifying your core OpenCart database structure.
        </p>

        <!-- Stats Counter Row -->
        <div class="row text-center" style="margin-bottom: 25px;">
          <div class="col-md-3 col-sm-6">
            <div class="well well-sm" style="background: #f8fafc; border: 1px solid #e2e8f0;">
              <h2 style="margin: 5px 0; color: #0d2a2c; font-weight: bold;">{{ stats.total_custom_tabs }}</h2>
              <span class="text-muted" style="font-size: 11px; text-transform: uppercase; font-weight: bold;">Custom Tabs Managed</span>
            </div>
          </div>
          <div class="col-md-3 col-sm-6">
            <div class="well well-sm" style="background: #f8fafc; border: 1px solid #e2e8f0;">
              <h2 style="margin: 5px 0; color: #0d2a2c; font-weight: bold;">{{ stats.total_option_skus }}</h2>
              <span class="text-muted" style="font-size: 11px; text-transform: uppercase; font-weight: bold;">Option SKUs Linked</span>
            </div>
          </div>
          <div class="col-md-3 col-sm-6">
            <div class="well well-sm" style="background: #f8fafc; border: 1px solid #e2e8f0;">
              <h2 style="margin: 5px 0; color: #0d2a2c; font-weight: bold;">{{ stats.total_images_deduped }}</h2>
              <span class="text-muted" style="font-size: 11px; text-transform: uppercase; font-weight: bold;">Images Deduplicated</span>
            </div>
          </div>
          <div class="col-md-3 col-sm-6">
            <div class="well well-sm" style="background: #f8fafc; border: 1px solid #e2e8f0;">
              <h2 style="margin: 5px 0; color: #0d2a2c; font-weight: bold;">{{ stats.total_exports_recorded }}</h2>
              <span class="text-muted" style="font-size: 11px; text-transform: uppercase; font-weight: bold;">Export Audit Snapshots</span>
            </div>
          </div>
        </div>

        <!-- Capability Matrix Table -->
        <div class="table-responsive">
          <table class="table table-bordered table-striped">
            <thead>
              <tr style="background: #0d2a2c; color: #ffffff;">
                <th style="width: 25%;">Product Intelligence Capability</th>
                <th style="width: 25%;">Native OpenCart Limitation</th>
                <th style="width: 30%;">SaaS Connector Dedicated Architecture</th>
                <th style="width: 20%; text-align: center;">Operational Status</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Product Options with Variant SKUs</strong><br/><small class="text-muted">(Size, Desk Finish, Drawers)</small></td>
                <td><code>oc_product_option_value</code> table has NO SKU column for option-level parts.</td>
                <td>Stores variant SKUs in <code>{{ db_prefix }}saas_option_sku_map</code> without modifying core OpenCart tables.</td>
                <td style="text-align: center;"><span class="label label-success"><i class="fa fa-check"></i> Ready &amp; Active</span></td>
              </tr>
              <tr>
                <td><strong>Custom Product Tabs &amp; Bullet Specs</strong><br/><small class="text-muted">(Overview, Part Lists, Specs)</small></td>
                <td>OpenCart core only supports 1 single description HTML field.</td>
                <td>Injected dynamically into theme via <code>{{ db_prefix }}saas_product_tabs</code> and OCMOD XML.</td>
                <td style="text-align: center;"><span class="label label-success"><i class="fa fa-check"></i> Ready &amp; Active</span></td>
              </tr>
              <tr>
                <td><strong>Image Swatches &amp; Deduplication</strong><br/><small class="text-muted">(Finishing Swatches, Textures)</small></td>
                <td>OpenCart re-downloads duplicates and lacks SHA-256 hash checking.</td>
                <td>Validated via Magic Bytes and indexed in <code>{{ db_prefix }}saas_image_registry</code>.</td>
                <td style="text-align: center;"><span class="label label-success"><i class="fa fa-check"></i> Ready &amp; Active</span></td>
              </tr>
              <tr>
                <td><strong>HMAC-SHA256 Security &amp; Replay Block</strong><br/><small class="text-muted">(Signatures, Nonce verification)</small></td>
                <td>Standard API keys lack replay attack prevention or timestamp window.</td>
                <td>Non-reusable cryptographically hashed nonces in <code>{{ db_prefix }}saas_nonce_cache</code>.</td>
                <td style="text-align: center;"><span class="label label-success"><i class="fa fa-check"></i> Ready &amp; Active</span></td>
              </tr>
              <tr>
                <td><strong>Rollback Safety &amp; Audit Logs</strong><br/><small class="text-muted">(Zero damage rollback guarantee)</small></td>
                <td>OpenCart has no automated undo or historical state snapshots.</td>
                <td>Snapshots saved in <code>{{ db_prefix }}saas_export_history</code> before each export.</td>
                <td style="text-align: center;"><span class="label label-success"><i class="fa fa-check"></i> Ready &amp; Active</span></td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Recent Connector Logs Table -->
        <h4 style="margin-top: 30px; font-weight: bold;"><i class="fa fa-history"></i> Recent Integration Logs &amp; Diagnostics</h4>
        <div class="table-responsive">
          <table class="table table-bordered table-condensed" style="font-size: 12px;">
            <thead>
              <tr style="background: #f1f5f9;">
                <th style="width: 15%;">Timestamp</th>
                <th style="width: 10%;">Level</th>
                <th>Message / Event Context</th>
              </tr>
            </thead>
            <tbody>
              {% if recent_logs %}
                {% for log in recent_logs %}
                <tr>
                  <td style="font-family: monospace;">{{ log.created_at }}</td>
                  <td>
                    {% if log.level == 'ERROR' %}
                    <span class="label label-danger">{{ log.level }}</span>
                    {% elseif log.level == 'WARN' %}
                    <span class="label label-warning">{{ log.level }}</span>
                    {% else %}
                    <span class="label label-info">{{ log.level }}</span>
                    {% endif %}
                  </td>
                  <td>{{ log.message }}</td>
                </tr>
                {% endfor %}
              {% else %}
                <tr>
                  <td colspan="3" class="text-center text-muted" style="padding: 15px;">
                    No recent error logs. All webhook handshakes and export synchronizations are operating normally.
                  </td>
                </tr>
              {% endif %}
            </tbody>
          </table>
        </div>
      </div>
    </div>

  </div>
</div>
{{ footer }}

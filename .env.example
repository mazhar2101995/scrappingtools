# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION (AI Product Intelligence SaaS)
# Copy this file to .env and adjust as necessary for your local or cloud setup.
# DO NOT COMMIT SENSITIVE VALUES OR PRODUCTION CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Global & Application Environment
# ------------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=ai-product-intelligence
PORT=3000
API_PORT=4000
FASTAPI_PORT=8000

# ------------------------------------------------------------------------------
# 2. PostgreSQL Configuration (via Docker or Local)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_DB=product_intelligence_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres_dev_password@localhost:5432/product_intelligence_dev

# ------------------------------------------------------------------------------
# 3. Redis Configuration (BullMQ & Cache)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_password
REDIS_URL=redis://:redis_dev_password@localhost:6379/0

# ------------------------------------------------------------------------------
# 4. Optional Vector Store (Qdrant)
# ------------------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# ------------------------------------------------------------------------------
# 5. Optional Object Storage (MinIO S3-Compatible)
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=product-intelligence-assets

# ------------------------------------------------------------------------------
# 6. AI Engine & Scraping Services
# ------------------------------------------------------------------------------
SCRAPING_SERVICE_URL=http://localhost:8000
PLAYWRIGHT_HEADLESS=true
PYTHON_ENV=development


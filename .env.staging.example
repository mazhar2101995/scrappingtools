# Staging Environment Configuration Template
# Copy this file to .env.staging and set actual secure secrets.

# Domain & Access
STAGING_DOMAIN=staging.yourdomain.com
NODE_ENV=production

# Database (PostgreSQL 16)
POSTGRES_USER=saas_staging_user
POSTGRES_PASSWORD=generate_strong_staging_db_password_32chars
POSTGRES_DB=product_intelligence_staging
POSTGRES_PORT=5432

# Redis 7
REDIS_PASSWORD=generate_strong_staging_redis_password_32chars
REDIS_PORT=6379

# JWT Authentication
JWT_SECRET=generate_cryptographically_secure_jwt_secret_minimum_64_characters
JWT_EXPIRES_IN=24h

# Optional External AI API Key (For non-deterministic fallback)
GEMINI_API_KEY=your_gemini_api_key_here

